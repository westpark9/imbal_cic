{
  "dataset": "CSE-CIC-IDS2018-PCAP-expanded",
  "purpose": "Build an encoder-independent, group-split raw-PCAP corpus with broad CIC2018 attack families; make a frozen netFound-v2-small view; then compare XGBoost and frozen TabPFN on exactly matched few-shot rows. This is a new feature representation and split, not a reproduction of the prior NF-v3 scores.",
  "seed": 43,
  "label_source": "https://github.com/GintsEngelen/CNS2022_Code/blob/master/Labelling/CICIDS2018_labelling_fixed_CICFlowMeter.ipynb",
  "label_rule_note": "Rules transcribe the corrected-CICFlowMeter notebook's attack interval, endpoint and stated feature filters. Sessions are independently reconstructed from PCAP, so labels have the same documented intent but are not asserted to reproduce notebook rows one-for-one. Unmatched daily-capture traffic is background benign; flows crossing an attack-rule boundary remain unresolved. Raw attack names are retained as annotation_label and evaluation uses the documented NF-v3-aligned family mapping.",
  "class_order": ["benign", "ddos", "bot", "dos", "bf", "inf", "web"],
  "evaluation_label_note": "Classifier labels use the seven attack families used for the prior NF-v3 comparison: benign, ddos, bot, dos, bf, inf and web. The corrected-CICFlowMeter source annotation remains in annotation_label; the corpus manifest records every direct source annotation and rule ID per family.",
  "split_fractions": [0.7, 0.15, 0.15],
  "corpus": {
    "reservoir_per_label_split": 1024,
    "reservoir_unresolved_per_split": 256,
    "reconstruction_contract": "flow_id, bidirectional five-tuple, start/end packet positions and bounded netFound tokens identify a session. A future encoder may re-open the checksum-pinned PCAP and reconstruct all packets using capture_id plus the flow locator; it must write a separate encoder view without changing corpus labels, IDs or splits."
  },
  "flow": {
    "idle_seconds": 120,
    "active_seconds": 5,
    "reorder_seconds": 1.0,
    "allow_truncated": true
  },
  "encoders": {
    "netfound-v2-small": {
      "checkpoint": "data/pcap_models/netfound-small",
      "dtype": "float32",
      "feature_description": "512-dimensional frozen netFound v2 header/timing representation, projected to 64 dimensions with training-split PCA. Raw payload, IP addresses, ports, absolute timestamps, labels and split are excluded from encoder input."
    }
  },
  "projection": {
    "components": 64,
    "fit_scope": "all training-split corpus flows, including unresolved flows; neither validation nor test flows are used"
  },
  "fewshot": {
    "budgets": [2, 3, 5, 10, 20, 50],
    "seeds": [43, 44, 45, 46, 47],
    "methods": ["xgb", "tabpfn"],
    "regimes": ["with_benign", "attack_only"],
    "tabpfn_checkpoint": "tabpfn/tabpfn-v3-classifier-v3_20260417_multiclass.ckpt",
    "paired_sampling": "For every class, seed and n, a deterministic maximum-n sample is drawn from only its training split and its first n rows are used by both methods. Test rows and PCA are held fixed across methods.",
    "interpretation": "with_benign is the primary IDS task. attack_only is a diagnostic that removes normal-vs-attack separation and must not replace the primary result."
  },
