\@writefile{toc}{\contentsline {section}{\numberline {7}Temporal-arrival protocol (EXP68)}{4}{section.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Temporal-arrival protocol on ToN-IoT (EXP68, seed 43): test rows in time order, five equal periods; in each period the first 10\% of every family\textquotesingle s rows may be labelled (at most 50 per class) and the rest is evaluated. Macro-F1 over the classes present in the period. TabPFN + context appends the labelled rows to C0 without any weight update; XGB retrained refits on C0 plus the accumulated labels.}}{4}{table.8}\protected@file@percent }
\newlabel{tab:temporal_arrival}{{8}{4}{Temporal-arrival protocol on ToN-IoT (EXP68, seed 43): test rows in time order, five equal periods; in each period the first 10\% of every family\textquotesingle s rows may be labelled (at most 50 per class) and the rest is evaluated. Macro-F1 over the classes present in the period. TabPFN + context appends the labelled rows to C0 without any weight update; XGB retrained refits on C0 plus the accumulated labels}{table.8}{}}
