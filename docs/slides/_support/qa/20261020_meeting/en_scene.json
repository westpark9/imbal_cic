            0.19,
            0.285
          ]
        },
        {
          "kind": "text",
          "x": 4.98,
          "y": 1.36,
          "w": 7.73,
          "h": 0.45,
          "text": "4  Consult examples · In-context learning",
          "size": 22,
          "bold": true,
          "color": "007BC6"
        },
        {
          "kind": "text",
          "x": 5.33,
          "y": 2.03,
          "w": 7.23,
          "h": 0.78,
          "text": "Compare the query with labelled context examples\nWeight their relevance through attention",
          "size": 20,
          "bold": false,
          "color": "20262E"
        },
        {
          "kind": "text",
          "x": 4.98,
          "y": 3.02,
          "w": 7.73,
          "h": 0.45,
          "text": "5  Predict probabilities · Many-class decoder",
          "size": 22,
          "bold": true,
          "color": "007BC6"
        },
        {
          "kind": "text",
          "x": 5.33,
          "y": 3.69,
          "w": 7.23,
          "h": 0.78,
          "text": "Combine context labels with attention weights\nKeep examples of both existing and new classes",
          "size": 20,
          "bold": false,
          "color": "20262E"
        },
        {
          "kind": "box",
          "x": 4.98,
          "y": 5.11,
          "w": 7.7,
          "h": 1.57,
          "fill": "F1F5F9"
        },
        {
          "kind": "text",
          "x": 5.2,
          "y": 5.31,
          "w": 7.25,
          "h": 0.35245,
          "text": "Context updates also require computation",
          "size": 21,
          "bold": true,
          "color": "00306C"
        },
        {
          "kind": "text",
          "x": 5.2,
          "y": 5.96,
          "w": 7.23,
          "h": 0.6042,
          "text": "Preprocessing · Representations · Cache preparation\nMeasure update time separately from weight training",
          "size": 18,
          "bold": false,
          "color": "20262E"
        }
      ]
    }
