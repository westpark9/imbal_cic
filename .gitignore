# per-row posteriors/logits saved by exp35-37 (113 MB each at 4.02M rows); CSV/JSON summaries are tracked
tabpfn/results/**/*.npy
# Reconstructible routing models and host-local launch manifests
tabpfn/results/**/*.joblib
# Fitted Global state retained locally for residual-membership replay.
tabpfn/results/**/*.tabpfn_fit
tabpfn/logs/*.process.json

# local-only symlink to the shared data store; each box provides its own
/data

# vendored third-party PFN code (tabpfn/third_party/): source is tracked, weights/data/outputs are not
# Independent official Git clones. Recreate using scripts/common/sota_sources.py.
# Keep their nested .git directories, checkpoints, datasets and outputs out of this repository.
/tabpfn/third_party/upstream/
# Reconstructible PCAP vectors and per-flow source metadata; small audits stay tracked.
/tabpfn/results/v7/exp92/**/flows.jsonl
/tabpfn/results/v7/exp92/**/vectors.csv
/tabpfn/results/v7/exp92/**/collision_audit.json
# EXP93 keeps compact manifests and metric summaries, but reconstructs these
# PCAP-derived row and vector artifacts locally.
/tabpfn/results/v7/exp93/**/corpus/flows.jsonl
/tabpfn/results/v7/exp93/**/encoders/**/embeddings.npy
/tabpfn/results/v7/exp93/**/encoders/**/*.npz
/tabpfn/results/v7/exp93/**/evaluations/**/predictions.npy
*.cpkt
*.cpkt.*
tabpfn/third_party/BoostPFN/datasets/*.pickle
tabpfn/third_party/BoostPFN/largeresults/
tabpfn/third_party/BoostPFN/log.txt
tabpfn/third_party/DistPFN/src/plots/img/

